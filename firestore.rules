rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document: users/{userId}
    // Only the authenticated user can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User expenses subcollection: users/{userId}/expenses/{expenseId}
      // Only the authenticated user can read, create, update, or delete their own expenses
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
